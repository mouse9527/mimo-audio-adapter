# ---- upstream endpoint (configuration, NOT a credential) ------------------
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ---- credentials ----------------------------------------------------------
# There are none. The adapter holds no API key.
# The caller (LiteLLM) supplies the MiMo credential in the Authorization
# header, and the adapter relays it upstream verbatim. The secret therefore
# lives in exactly one place: LiteLLM's encrypted credential store.

# ---- defaults -------------------------------------------------------------
DEFAULT_ASR_MODEL=mimo-v2.5-asr
DEFAULT_TTS_MODEL=mimo-v2.5-tts
DEFAULT_ASR_LANGUAGE=zh
DEFAULT_TTS_VOICE=冰糖
DEFAULT_TTS_FORMAT=wav

# Map OpenAI voice names onto MiMo presets, for callers with a fixed voice list.
VOICE_ALIASES=alloy=冰糖,echo=苏打,fable=茉莉,onyx=白桦,nova=Chloe,shimmer=Mia

# ---- runtime --------------------------------------------------------------
PORT=8000
REQUEST_TIMEOUT=120
CONNECT_TIMEOUT=10
# Only used for mp3/opus/aac/flac output; wav and pcm never invoke ffmpeg.
FFMPEG_BINARY=ffmpeg
TRANSCODE_TIMEOUT=30
MAX_AUDIO_BYTES=7340032
LOG_LEVEL=INFO
